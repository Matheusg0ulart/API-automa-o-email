# ==============================================================================
# CONFIGURAÇÃO DE CONEXÃO COM O E-MAIL (GMAIL OU E-MAIL CORPORATIVO)
# ==============================================================================

# Seu endereço de e-mail completo
EMAIL_USER=seu_email@gmail.com

# Para o GMAIL: NÃO use sua senha normal da conta!
# Você deve gerar uma "Senha de Aplicativo" de 16 letras na conta Google:
# 1. Acesse https://myaccount.google.com/security
# 2. Ative a "Verificação em duas etapas" (se ainda não tiver ativado)
# 3. Pesquise por "Senhas de app" ou acesse https://myaccount.google.com/apppasswords
# 4. Crie um app chamado "AutomacaoPython" e copie a senha gerada (16 caracteres)
EMAIL_PASSWORD=sua_senha_de_app_ou_senha_corporativa

# Servidor IMAP:
# Para Gmail: imap.gmail.com
# Para Outlook/Office 365: outlook.office365.com
# Para Yahoo: imap.mail.yahoo.com
# Para e-mail próprio/cPanel/Hostinger: mail.seudominio.com.br
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993

# ==============================================================================
# PREFERÊNCIAS DA AUTOMAÇÃO
# ==============================================================================

# Pasta de origem para ler os e-mails (Padrão: INBOX)
MAILBOX_SOURCE=INBOX

# Processar apenas e-mails não lidos? (True = apenas não lidos, False = todos dentro do limite)
ONLY_UNREAD=True

# Limite máximo de e-mails para processar por rodada (evita sobrecarga)
MAX_EMAILS_PER_RUN=50

# Modo de simulação padrão (True = apenas analisa sem mover no servidor, False = move e aplica)
DRY_RUN=True

# Domínio corporativo da sua empresa (ajuda a identificar e-mails internos da empresa)
# Exemplo: minhaempresa.com.br (deixe vazio se não tiver)
COMPANY_DOMAIN=minhaempresa.com.br

# Intervalo de monitoramento automático em minutos (para modo contínuo)
MONITOR_INTERVAL_MINUTES=5

# ==============================================================================
# INTELIGÊNCIA ARTIFICIAL (OPCIONAL)
# ==============================================================================
# Se informada, utiliza IA generativa para gerar resumos de 1 frase, nível de
# urgência e valores monetários estimados. Se vazia, o sistema utiliza o motor
# heurístico inteligente offline gratuitamente!
GEMINI_API_KEY=
OPENAI_API_KEY=

# ==============================================================================
# RESPOSTA AUTOMÁTICA INTELIGENTE (AUTO-REPLY COMERCIAL)
# ==============================================================================
# Envia confirmação profissional automática para remetentes de orçamentos e propostas
ENABLE_AUTO_REPLY=False
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ==============================================================================
# SERVIDOR WEB & PAINEL DASHBOARD
# ==============================================================================
WEB_HOST=127.0.0.1
WEB_PORT=8000
